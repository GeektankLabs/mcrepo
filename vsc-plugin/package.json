{
  "name": "mcrepo-multi-context",
  "displayName": "mcrepo (Multi-Context)",
  "description": "Explorer mode badges for mcrepo multi-context repositories",
  "version": "0.1.2",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:mcrepo.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcrepoDecorations.refresh",
        "title": "mcrepo (Multi-Context): Refresh Decorations"
      },
      {
        "command": "mcrepoDecorations.setWrite",
        "title": "\ud83d\uddc2 \u270f\ufe0f Set Write"
      },
      {
        "command": "mcrepoDecorations.setRead",
        "title": "\ud83d\uddc2 \ud83d\udc40 Set Read"
      },
      {
        "command": "mcrepoDecorations.setSleep",
        "title": "\ud83d\uddc2 \ud83d\udca4 Set Sleep"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcrepoDecorations.setWrite",
          "group": "navigation@mcrepo",
          "when": "mcrepo.isWorkspace && explorerResourceIsFolder && resourceScheme == file && resourceFilename != '+-contracts' && resourceFilename != '+-docs' && resourceFilename != '+-tests' && resourceFilename != '+-skills'"
        },
        {
          "command": "mcrepoDecorations.setRead",
          "group": "navigation@mcrepo",
          "when": "mcrepo.isWorkspace && explorerResourceIsFolder && resourceScheme == file && resourceFilename != '+-contracts' && resourceFilename != '+-docs' && resourceFilename != '+-tests' && resourceFilename != '+-skills'"
        },
        {
          "command": "mcrepoDecorations.setSleep",
          "group": "navigation@mcrepo",
          "when": "mcrepo.isWorkspace && explorerResourceIsFolder && resourceScheme == file && resourceFilename != '+-contracts' && resourceFilename != '+-docs' && resourceFilename != '+-tests' && resourceFilename != '+-skills'"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node18",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node18 --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  }
}
